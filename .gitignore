# ============================================================
# CAT STATE LAYER — whitelist policy (v0.24.0, DESIGN-IGNORE-002)
# Default: state files ARE tracked (git add works without -f).
# Volatile/private zones are excluded below.
# Host override: your ROOT .gitignore wins over this nested file.
# ============================================================

# volatile / regenerable zones — NOT tracked
ai_workspace/temp/
ai_workspace/sessions/
ai_workspace/scratchpad/
ai_workspace/**/.pytest_cache/
ai_workspace/**/__pycache__/
ai_workspace/**/*.bak
ai_workspace/**/*.log

# notes are private by default (FR-0015): uncomment the next line's
# opposite to opt OUT of tracking entirely, or keep tracked by deleting
# the line below for fully-private deployments:
ai_workspace/notes/

# inspiration_capital user cards stay untracked
ai_workspace/inspiration_capital/cards/**

# runtime
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Temporary/cache
*.tmp
*.temp
*.log
*.bak
*.backup
.cache/
*.cache

# Paper artifacts
paper/*.tex
paper/*.bib
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.log
paper/figures/
paper/README.md

# paper v2 reference (copyrighted, not committed)
paper_v2/reference/
